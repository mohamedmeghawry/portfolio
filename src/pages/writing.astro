---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date) =>
  date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Layout title="Writing | Mohamed Meghawry">
  <h1 class="text-3xl font-bold tracking-tight">Writing</h1>
  <p class="mt-4 text-gray-600">Lab writeups, certification notes, and observations from the SOC pathway.</p>

  {posts.length === 0 ? (
    <div class="mt-12 text-gray-500 italic">First posts coming soon.</div>
  ) : (
    <ul class="mt-12 space-y-8 list-none m-0 p-0">
      {posts.map((post) => (
        <li>
          <a href={`/writing/${post.id}`} class="block group">
            <h2 class="text-xl font-semibold tracking-tight group-hover:text-gray-500 transition-colors">{post.data.title}</h2>
            <p class="mt-1 text-sm text-gray-500">{formatDate(post.data.pubDate)}</p>
            <p class="mt-2 text-gray-700 leading-relaxed">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  )}
</Layout>
